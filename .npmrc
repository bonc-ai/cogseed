# npmmirror is a full reverse proxy of the official registry. package-lock.json
# integrity hashes are still enforced, so a tampered package fails to install.
registry=https://registry.npmmirror.com

# Binary downloads that otherwise come from GitHub releases.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
better_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/better-sqlite3
