{
  "version": "1.0",
  "name": "cognition-lifecycle",
  "goal": "将有来源的认知候选安全地沉淀为可复用长期记忆，并在复用、失效和重确认过程中保持可恢复、可审计的生命周期。",
  "acceptance_criteria": [
    "每个候选认知都带有至少一条结构化来源证据。",
    "没有经过人工确认的认知不会进入共享长期记忆或模型上下文。",
    "长期记忆写入失败时，候选状态保持可重试且不会产生重复记忆。",
    "长期记忆被删除、替换或内容改变时，认知会被标记为失效并要求重新确认。",
    "确认后的每次复用都可追溯到来源，达到复用阈值后进入 bright 阶段。",
    "每个节点执行都有结构化轨迹，所有循环、重试和副作用都有明确边界。"
  ],
  "start": "capture_candidate",
  "terminals": [
    "pending_review",
    "deferred",
    "bright",
    "invalidated",
    "failed"
  ],
  "budgets": {
    "max_steps": 12,
    "max_retries_per_node": 2,
    "max_wall_seconds": 300,
    "max_cost_usd": 0
  },
  "state": {
    "schema_version": 1,
    "fields": {
      "run_id": {"type": "string", "owner": "orchestrator"},
      "user_id": {"type": "string", "owner": "orchestrator"},
      "asset_id": {"type": "string", "owner": "capture_candidate"},
      "candidate": {"type": "object", "owner": "capture_candidate"},
      "evidence": {"type": "array", "owner": "validate_evidence"},
      "review_decision": {"type": "string", "owner": "human_review"},
      "memory_operation": {"type": "object", "owner": "activate_memory"},
      "memory_result": {"type": "object", "owner": "verify_activation"},
      "reuse_event": {"type": "object", "owner": "record_reuse"},
      "reuse_count": {"type": "integer", "owner": "orchestrator"},
      "reconciliation": {"type": "object", "owner": "reconcile_memory"},
      "attempt": {"type": "integer", "owner": "orchestrator"},
      "event": {"type": "string", "owner": "orchestrator"},
      "trace": {"type": "array", "owner": "orchestrator"}
    }
  },
  "nodes": [
    {
      "id": "capture_candidate",
      "kind": "deterministic",
      "purpose": "创建或恢复一个带候选正文和来源标识的认知资产。",
      "reads": ["user_id", "candidate"],
      "writes": ["asset_id", "candidate"],
      "timeout_seconds": 10,
      "side_effects": "cloud cognition store write",
      "idempotency": "asset idempotency key; replay returns the existing candidate"
    },
    {
      "id": "validate_evidence",
      "kind": "deterministic",
      "purpose": "校验来源类型、摘要、来源标签和关联会话/项目标识。",
      "reads": ["candidate"],
      "writes": ["evidence"],
      "timeout_seconds": 10,
      "side_effects": "none",
      "idempotency": "replayable"
    },
    {
      "id": "human_review",
      "kind": "human_gate",
      "purpose": "展示候选正文和来源证据，由用户决定确认、暂缓或拒绝。",
      "reads": ["asset_id", "candidate", "evidence"],
      "writes": ["review_decision"],
      "timeout_seconds": 0,
      "side_effects": "review decision write",
      "idempotency": "decision key prevents duplicate transitions"
    },
    {
      "id": "activate_memory",
      "kind": "deterministic",
      "purpose": "在确认边界之后，将认知写入共享长期记忆或恢复一个已完成的幂等写入。",
      "reads": ["user_id", "asset_id", "candidate", "review_decision", "attempt"],
      "writes": ["memory_operation"],
      "timeout_seconds": 30,
      "side_effects": "shared memory write",
      "idempotency": "source id plus content hash; never append a duplicate record"
    },
    {
      "id": "verify_activation",
      "kind": "deterministic",
      "purpose": "验证长期记忆记录、内容哈希和认知资产绑定是否一致。",
      "reads": ["user_id", "asset_id", "candidate", "memory_operation"],
      "writes": ["memory_result"],
      "timeout_seconds": 20,
      "side_effects": "cognition store state write",
      "idempotency": "replayable reconciliation"
    },
    {
      "id": "active_state",
      "kind": "deterministic",
      "purpose": "根据后续事件把已激活认知路由到复用记录或记忆一致性检查。",
      "reads": ["user_id", "asset_id", "event"],
      "writes": [],
      "timeout_seconds": 10,
      "side_effects": "none",
      "idempotency": "replayable"
    },
    {
      "id": "record_reuse",
      "kind": "deterministic",
      "purpose": "记录一次已确认认知的结构化复用事件并重新计算成长阶段。",
      "reads": ["user_id", "asset_id", "reuse_event"],
      "writes": ["reuse_event"],
      "timeout_seconds": 15,
      "side_effects": "cloud cognition store write",
      "idempotency": "reuse event id prevents duplicate counting"
    },
    {
      "id": "reconcile_memory",
      "kind": "deterministic",
      "purpose": "检查已确认资产对应的长期记忆是否仍存在且内容未改变，必要时生成失效状态。",
      "reads": ["user_id", "asset_id", "candidate"],
      "writes": ["reconciliation"],
      "timeout_seconds": 20,
      "side_effects": "cognition store state write",
      "idempotency": "replayable and monotonic invalidation"
    }
  ],
  "edges": [
    {"from": "capture_candidate", "to": "validate_evidence", "when": "asset_id.present == true"},
    {"from": "capture_candidate", "to": "failed", "when": "asset_id.present == false"},
    {"from": "validate_evidence", "to": "human_review", "when": "evidence.valid == true"},
    {"from": "validate_evidence", "to": "failed", "when": "evidence.valid == false"},
    {"from": "human_review", "to": "activate_memory", "when": "review_decision == 'confirm'"},
    {"from": "human_review", "to": "deferred", "when": "review_decision == 'defer'"},
    {"from": "human_review", "to": "pending_review", "when": "review_decision == 'reject'"},
    {"from": "activate_memory", "to": "verify_activation", "when": "memory_operation.completed == true"},
    {
      "from": "activate_memory",
      "to": "activate_memory",
      "when": "memory_operation.retryable == true && attempt < 3",
      "state_updates": {"attempt": "attempt + 1"}
    },
    {"from": "activate_memory", "to": "failed", "when": "memory_operation.retryable != true || attempt >= 3"},
    {"from": "verify_activation", "to": "active_state", "when": "memory_result.bound == true && reuse_count < 3"},
    {"from": "verify_activation", "to": "bright", "when": "memory_result.bound == true && reuse_count >= 3"},
    {"from": "verify_activation", "to": "failed", "when": "memory_result.bound != true"},
    {"from": "active_state", "to": "record_reuse", "when": "event == 'reuse'"},
    {"from": "active_state", "to": "reconcile_memory", "when": "event == 'reconcile'"},
    {"from": "active_state", "to": "failed", "when": "event != 'reuse' && event != 'reconcile'"},
    {"from": "record_reuse", "to": "bright", "when": "reuse_count >= 3"},
    {"from": "record_reuse", "to": "active_state", "when": "reuse_count < 3"},
    {"from": "reconcile_memory", "to": "invalidated", "when": "reconciliation.valid == false"},
    {"from": "reconcile_memory", "to": "active_state", "when": "reconciliation.valid == true && reuse_count < 3"},
    {"from": "reconcile_memory", "to": "bright", "when": "reconciliation.valid == true && reuse_count >= 3"}
  ],
  "checkpoints": [
    "after:capture_candidate",
    "before:activate_memory",
    "after:verify_activation",
    "before:record_reuse",
    "after:reconcile_memory"
  ],
  "human_gates": [
    {
      "before": "activate_memory",
      "role": "authenticated_user",
      "actions": ["confirm", "defer", "reject"]
    }
  ],
  "observability": {
    "trace_fields": ["run_id", "user_id_hash", "asset_id", "node", "attempt", "route", "duration_ms", "error_code"],
    "metrics": ["candidate_capture_rate", "confirmation_rate", "activation_success_rate", "activation_retry_rate", "reuse_rate", "invalidation_rate", "steps_per_run"]
  },
  "evaluations": [
    {
      "name": "cognition-lifecycle-baseline",
      "compare": ["evidence_integrity", "approval_boundary", "idempotent_recovery", "invalidation_accuracy", "latency"]
    }
  ]
}
