{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cogseed.security.skill/1.1.1/manifest.schema.json",
  "title": "Skill Security Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "security_ontology",
    "skill",
    "ownership",
    "provenance",
    "permissions",
    "resources",
    "actions",
    "data_security",
    "network",
    "runtime_boundary",
    "risk",
    "approval",
    "audit",
    "rollback",
    "dependencies",
    "tests"
  ],
  "properties": {
    "manifest_version": { "type": "string" },
    "security_ontology": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "cogseed.security.skill" },
        "version": { "type": "string" }
      }
    },
    "skill": {
      "type": "object",
      "required": ["id", "name", "version", "description", "environment", "artifact_manifest_ref", "skill_spec_ref", "business_ontology_ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["development", "test", "staging", "production"] },
        "artifact_manifest_ref": { "type": "string" },
        "skill_spec_ref": { "type": "string" },
        "business_ontology_ref": { "type": "string" }
      }
    },
    "ownership": {
      "type": "object",
      "required": ["human_owner", "organization", "role"],
      "properties": {
        "human_owner": { "type": "string" },
        "organization": { "type": "string" },
        "role": { "type": "string" },
        "technical_owner": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_type", "source_uri", "author", "checksum"],
      "properties": {
        "source_type": { "enum": ["internal", "generated", "third_party", "modified_third_party"] },
        "source_uri": { "type": "string" },
        "author": { "type": "string" },
        "checksum": {
          "oneOf": [
            { "const": "DEFERRED_UNTIL_FREEZE" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "signature": { "type": ["string", "null"] }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["required", "prohibited"],
      "properties": {
        "required": { "type": "array", "items": { "type": "object" } },
        "prohibited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resources": {
      "type": "object",
      "required": ["allowed", "denied"],
      "properties": {
        "allowed": { "type": "array", "items": { "type": "object" } },
        "denied": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actions": {
      "type": "object",
      "required": ["allowed", "prohibited"],
      "properties": {
        "allowed": { "type": "array", "items": { "type": "object" } },
        "prohibited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "data_security": {
      "type": "object",
      "required": ["input_classification", "output_classification", "external_transmission", "pii_allowed", "secrets_allowed", "retention_days"],
      "properties": {
        "input_classification": {
          "type": "array",
          "items": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] }
        },
        "output_classification": {
          "type": "array",
          "items": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] }
        },
        "external_transmission": { "type": "boolean" },
        "pii_allowed": { "type": "boolean" },
        "secrets_allowed": { "type": "boolean" },
        "retention_days": { "type": "integer", "minimum": 0 }
      }
    },
    "network": {
      "type": "object",
      "required": ["enabled", "allowlist", "deny_private_network", "allow_dynamic_download"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowlist": { "type": "array", "items": { "type": "string" } },
        "deny_private_network": { "type": "boolean" },
        "allow_dynamic_download": { "type": "boolean" }
      }
    },
    "runtime_boundary": {
      "type": "object",
      "required": ["runtime_contracts_ref", "direct_resource_access", "access_via_gateway_only", "binding_resolved_by", "audit_emitted_by"],
      "properties": {
        "runtime_contracts_ref": { "type": "string" },
        "direct_resource_access": { "const": false },
        "access_via_gateway_only": { "const": true },
        "binding_resolved_by": { "const": "agent_layer" },
        "audit_emitted_by": { "const": "runtime" }
      }
    },
    "risk": {
      "type": "object",
      "required": ["risk_level", "trust_level", "risk_reasons", "maximum_impact"],
      "properties": {
        "risk_level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
        "trust_level": { "enum": ["T0", "T1", "T2", "T3", "T4"] },
        "risk_reasons": { "type": "array", "items": { "type": "string" } },
        "maximum_impact": { "type": "string" },
        "calculated_risk_level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
        "effective_risk_level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
        "calculation_rule_version": { "type": "string" },
        "calculation_factors": { "type": "object" },
        "triggered_rule_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approval": {
      "type": "object",
      "required": ["required", "mode", "required_for_actions", "approver_roles"],
      "properties": {
        "required": { "type": "boolean" },
        "mode": { "enum": ["none", "single", "dual", "security_review"] },
        "required_for_actions": { "type": "array", "items": { "type": "string" } },
        "approver_roles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audit": {
      "type": "object",
      "required": ["enabled", "events", "include_input", "include_output", "include_tool_calls", "include_policy_decision", "retention_days"],
      "properties": {
        "enabled": { "type": "boolean" },
        "events": { "type": "array", "items": { "type": "string" } },
        "include_input": { "type": "boolean" },
        "include_output": { "type": "boolean" },
        "include_tool_calls": { "type": "boolean" },
        "include_policy_decision": { "type": "boolean" },
        "retention_days": { "type": "integer", "minimum": 0 }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["supported", "type", "procedure", "maximum_recovery_time_minutes"],
      "properties": {
        "supported": { "type": "boolean" },
        "type": { "type": "string" },
        "procedure": { "type": "string" },
        "maximum_recovery_time_minutes": { "type": "integer", "minimum": 0 }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["packages", "external_tools"],
      "properties": {
        "packages": { "type": "array" },
        "external_tools": { "type": "array" }
      }
    },
    "tests": {
      "type": "object",
      "required": ["evals_ref", "validation_contract_ref", "minimum_test_cases"],
      "properties": {
        "evals_ref": { "type": "string" },
        "validation_contract_ref": { "type": "string" },
        "minimum_test_cases": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "x-mode-required": {
    "PREVALIDATION": {
      "allow_deferred": ["provenance.checksum"],
      "allow_required_input": true
    },
    "FREEZE": {
      "allow_deferred": [],
      "allow_required_input": false
    },
    "FORMAL_TEST": {
      "allow_deferred": [],
      "allow_required_input": false
    }
  }
}
