{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-sentry.local/schemas/report-schema.json",
  "title": "Skill Sentry Report",
  "description": "Skill Sentry 扫描报告契约（9 个核心字段 + 2.2.0 新增的评分拆解 / 框架映射 / 覆盖信息 + 支撑信息）。scan() 的返回值必须符合此 schema。",
  "type": "object",
  "required": [
    "scanner",
    "scanner_version",
    "ruleset_version",
    "security_score",
    "risk_classification",
    "attack_surface",
    "permission_summary",
    "data_access_summary",
    "dangerous_action_list",
    "vulnerability_findings",
    "required_mitigations",
    "deployment_recommendation",
    "score_breakdown",
    "severity_counts",
    "framework_summary",
    "findings",
    "hard_blocked",
    "confirmed_critical",
    "coverage",
    "limitations"
  ],
  "properties": {
    "scanner": {
      "type": "string",
      "const": "skill-sentry"
    },
    "scanner_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "ruleset_version": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "skill_path": {
      "type": "string"
    },
    "security_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "risk_classification": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "attack_surface": {
      "type": "object",
      "required": [
        "network_egress_points",
        "dynamic_execution_points",
        "persistence_points",
        "binary_files",
        "has_binaries"
      ],
      "properties": {
        "network_egress_points": {
          "type": "array"
        },
        "dynamic_execution_points": {
          "type": "array"
        },
        "persistence_points": {
          "type": "array"
        },
        "binary_files": {
          "type": "integer",
          "minimum": 0
        },
        "has_binaries": {
          "type": "boolean"
        }
      }
    },
    "permission_summary": {
      "type": "object",
      "required": [
        "declares_permissions",
        "has_hitl",
        "has_side_effects"
      ],
      "properties": {
        "declares_permissions": {
          "type": "boolean"
        },
        "has_hitl": {
          "type": "boolean"
        },
        "has_side_effects": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "data_access_summary": {
      "type": "object",
      "required": [
        "network_used",
        "egress_findings",
        "has_audit"
      ],
      "properties": {
        "network_used": {
          "type": "boolean"
        },
        "egress_findings": {
          "type": "integer",
          "minimum": 0
        },
        "has_audit": {
          "type": "boolean"
        },
        "binary_network_indicators": {
          "type": "array"
        }
      }
    },
    "dangerous_action_list": {
      "type": "array"
    },
    "vulnerability_findings": {
      "type": "array"
    },
    "required_mitigations": {
      "type": "array"
    },
    "deployment_recommendation": {
      "type": "string",
      "enum": [
        "ALLOW",
        "CAUTION",
        "DO_NOT_INSTALL"
      ]
    },
    "sr_items": {
      "type": "array"
    },
    "findings": {
      "type": "array",
      "description": "全部发现项。severity 为生效严重级（可能已被上下文降权）；original_severity 为规则声明的原始级别；context 记录降权依据。降权不删除 finding，审计时应同时看这三个字段。",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "original_severity",
          "demoted",
          "confidence",
          "category",
          "file",
          "description",
          "remediation",
          "cwe",
          "owasp_llm",
          "owasp_agentic",
          "fingerprint"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "original_severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "demoted": {
            "type": "boolean"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "Skill 内相对路径，绝不是绝对路径"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "hard_block": {
            "type": "boolean"
          },
          "context": {
            "type": "string"
          },
          "cwe": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owasp_llm": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owasp_agentic": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fingerprint": {
            "type": "string",
            "description": "跨行号稳定的问题指纹；不含匹配原文"
          },
          "suppressed": {
            "type": "boolean"
          },
          "suppressed_reason": {
            "type": "string"
          }
        },
        "not": {
          "required": [
            "snippet"
          ]
        }
      }
    },
    "hard_blocked": {
      "type": "boolean"
    },
    "binary_scan": {
      "type": "object"
    },
    "tool_status": {
      "type": "object"
    },
    "rules_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "description": "报告结构版本"
    },
    "scanned_at": {
      "type": "string",
      "description": "ISO-8601 扫描时间"
    },
    "score_breakdown": {
      "type": "object",
      "description": "分数拆解：每个类别的原始扣分、上限、生效扣分，以及触发的分数下限",
      "required": [
        "score",
        "raw_penalty",
        "penalty",
        "scale",
        "by_category",
        "floors"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "raw_penalty": {
          "type": "number"
        },
        "penalty": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        },
        "by_category": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "count",
              "raw",
              "cap",
              "penalty",
              "capped"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              },
              "raw": {
                "type": "number"
              },
              "cap": {
                "type": "number"
              },
              "penalty": {
                "type": "number"
              },
              "capped": {
                "type": "boolean"
              }
            }
          }
        },
        "floors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "severity_counts": {
      "type": "object",
      "description": "按生效严重级计数（含被抑制项）",
      "required": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "framework_summary": {
      "type": "object",
      "description": "OWASP LLM Top 10 (2025) / Agentic Top 10 (2026) 映射。是风险分类提示，不是合规认证结论。",
      "properties": {
        "owasp_llm": {
          "type": "array"
        },
        "owasp_agentic": {
          "type": "array"
        }
      }
    },
    "confirmed_critical": {
      "type": "boolean",
      "description": "存在未经上下文降权且高置信的 critical 命中（拒绝安装的依据）"
    },
    "coverage": {
      "type": "object",
      "description": "本次扫描实际覆盖了什么：规则条数、规则组、外部工具可用性、扫过的文件与上下文分布、规则包是否解析成功、编译失败的规则。",
      "properties": {
        "files_scanned": {
          "type": "integer"
        },
        "files_seen": {
          "type": "integer"
        },
        "bytes_scanned": {
          "type": "integer"
        },
        "rule_count": {
          "type": "integer"
        },
        "rule_groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hard_block_rules": {
          "type": "integer"
        },
        "contexts": {
          "type": "object"
        },
        "external_tools": {
          "type": "object"
        },
        "rules_source": {
          "type": "string"
        },
        "ruleset_resolved": {
          "type": "boolean"
        },
        "ruleset_version": {
          "type": "string"
        },
        "invalid_rules": {
          "type": "array"
        }
      }
    },
    "structural_summary": {
      "type": "object",
      "description": "文件构成统计"
    },
    "dependency_manifests": {
      "type": "object",
      "description": "依赖清单与运行时安装的包"
    },
    "baseline": {
      "type": "object",
      "description": "抑制清单统计"
    }
  }
}
