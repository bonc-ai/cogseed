# Ontology slice for <domain>. TBox = concepts, RBox = rules, ABox = instances.
# Rules are STRUCTURED (field/op/value + action) so downstream reads data, never parses
# the human-readable `formal` string.
tbox:
  <Entity>:
    - <field_a>
    - <field_b>

rbox:
  - rule_id: R1
    formal: "<human-readable rule, e.g. dispute_amount must not exceed 300>"
    field: <field_a>
    op: le                # le | lt | ge | gt | eq
    value: 300
    action: null          # null for a constraint; a policy_action name for a learnable policy
  - rule_id: R2
    formal: "<e.g. high-complaint customer: soothe before explaining>"
    field: <field_b>
    op: ge
    value: 3
    action: soothe_first  # a learnable policy the KSTAR loop can toggle (default off)

abox: {}                  # instances — usually empty at authoring time

# Traceability (GAP-1): where this slice came from. Platform ontology-registry binding
# is target-state (waits on the schema-authority decision); a local snapshot ref is fine now.
source_refs:
  - "materials::<domain>::snapshot"
