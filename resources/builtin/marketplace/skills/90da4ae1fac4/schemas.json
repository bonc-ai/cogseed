{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "skill_id": "skill.cogseed.fde.acceptance-evidence",
  "schema_version": "cogseed.skill-contract/1.0",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "task_id",
      "owner_context",
      "task_payload"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "minLength": 1
      },
      "owner_context": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_id",
          "role",
          "authorization_scope"
        ],
        "properties": {
          "owner_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "const": "fde_solution_delivery"
          },
          "authorization_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "task_payload": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "task_snapshot",
          "authorized_sources",
          "domain_context"
        ],
        "properties": {
          "task_snapshot": {
            "type": "object"
          },
          "authorized_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domain_context": {
            "type": "object"
          }
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "actions",
      "result",
      "trace",
      "audit_refs",
      "deliverable",
      "evidence",
      "assumptions",
      "open_questions",
      "asset_candidates"
    ],
    "properties": {
      "actions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "result": {
        "type": "object"
      },
      "trace": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "audit_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "deliverable": {
        "type": "object"
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "open_questions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "asset_candidates": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  },
  "runtime_contracts": {
    "resource": {
      "resource_requirements": [
        {
          "resource_type": "acceptance-evidence-task-material",
          "operation": "read",
          "purpose": "ontology_grounded_read",
          "min_scope": true
        }
      ],
      "access_via_gateway_only": true,
      "direct_resource_access": false
    },
    "permission": {
      "permissions": [
        {
          "action": "assess",
          "permission_level": "read",
          "hitl_required": false
        },
        {
          "action": "propose_candidate",
          "permission_level": "write",
          "hitl_required": true
        },
        {
          "action": "external_execute",
          "permission_level": "write",
          "hitl_required": true
        }
      ]
    },
    "owner_binding": {
      "required_owner_sections": [
        "role",
        "authorization_scope"
      ],
      "owner_context_ref": "input_schema.owner_context",
      "binding_resolved_by": "agent_layer"
    },
    "audit": {
      "audit_refs_field": "output_schema.audit_refs",
      "emitted_by": "runtime",
      "append_only": true
    }
  }
}
