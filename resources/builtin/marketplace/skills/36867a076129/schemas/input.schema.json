{
  "$id": "urn:ai-product-suite:build-evaluate-ai-product:input:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "owner_context": {
      "additionalProperties": false,
      "properties": {
        "authorization_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "owner_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "authorization_scope"
      ],
      "type": "object"
    },
    "product_version_id": {
      "pattern": "^PV-[0-9]{3,}$",
      "type": "string"
    },
    "stage_input": {
      "additionalProperties": false,
      "properties": {
        "plan_ref": {
          "minLength": 1,
          "type": "string"
        },
        "spec_ref": {
          "minLength": 1,
          "type": "string"
        },
        "tasks_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "spec_ref",
        "plan_ref",
        "tasks_ref"
      ],
      "type": "object"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "product_version_id",
    "owner_context",
    "stage_input"
  ],
  "title": "Build & Evaluate｜受控实现与评测 input",
  "type": "object"
}
