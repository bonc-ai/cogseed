{
  "$id": "urn:ai-product-suite:launch-learn-ai-product:input:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "owner_context": {
      "additionalProperties": false,
      "properties": {
        "authorization_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "owner_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "authorization_scope"
      ],
      "type": "object"
    },
    "product_version_id": {
      "pattern": "^PV-[0-9]{3,}$",
      "type": "string"
    },
    "stage_input": {
      "additionalProperties": false,
      "properties": {
        "outcome_definition": {
          "minLength": 1,
          "type": "string"
        },
        "real_run_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "release_decision_ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "release_decision_ref",
        "real_run_refs",
        "outcome_definition"
      ],
      "type": "object"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "product_version_id",
    "owner_context",
    "stage_input"
  ],
  "title": "Launch & Learn｜真实结果与受控演进 input",
  "type": "object"
}
