{
  "$id": "urn:ai-product-suite:discover-ai-product:output:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_gate": {
      "const": "Evidence Gate"
    },
    "approval_required": {
      "type": "boolean"
    },
    "artifact_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "claims_allowed": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "claims_prohibited": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "next_action": {
      "minLength": 1,
      "type": "string"
    },
    "stage": {
      "const": "Discover"
    },
    "status": {
      "enum": [
        "candidate",
        "needs_clarification",
        "blocked",
        "returned"
      ]
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "status",
    "summary",
    "stage",
    "artifact_refs",
    "evidence_refs",
    "next_action",
    "approval_required",
    "approval_gate",
    "claims_allowed",
    "claims_prohibited"
  ],
  "title": "Discover｜用户证据与旅程发现 output",
  "type": "object"
}
