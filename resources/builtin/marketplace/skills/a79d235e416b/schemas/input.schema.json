{
  "$id": "urn:ai-product-suite:discover-ai-product:input:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "owner_context": {
      "additionalProperties": false,
      "properties": {
        "authorization_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "owner_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "authorization_scope"
      ],
      "type": "object"
    },
    "product_version_id": {
      "pattern": "^PV-[0-9]{3,}$",
      "type": "string"
    },
    "stage_input": {
      "additionalProperties": false,
      "properties": {
        "participant_scope": {
          "minLength": 1,
          "type": "string"
        },
        "research_question": {
          "minLength": 1,
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "research_question",
        "participant_scope",
        "source_refs"
      ],
      "type": "object"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "product_version_id",
    "owner_context",
    "stage_input"
  ],
  "title": "Discover｜用户证据与旅程发现 input",
  "type": "object"
}
