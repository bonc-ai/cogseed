.DS_Store
/data
/node_modules
/resources/embedding-model
/resources/officecli
/resources/runtime/.python-*
/resources/runtime/.uv-*
/resources/runtime/.node-*
/resources/runtime/node
/resources/runtime/python
/resources/runtime/uv
/resources/runtime/ffmpeg
/resources/runtime/whisper
/resources/runtime/vc
/src/main/native/build/
/userWorkSpace

# Local multi-agent shared-file collaboration POC state
task.md
plan.md
.collab-poc/

# Local document/render outputs and workflow state
/.docx_render_*/
/.pdf_render_*/
/.superpowers/
/.codex-workflow/
/.zcode/
__pycache__/
*.py[cod]

# engine build artifacts
packages/*/node_modules
packages/*/dist

# electron-builder output and runtime render outputs
/dist
/output

# stray sidecar edits
package.json.new

# local build identity and development package output
/.build
/dist-dev

# 误解压到仓库根的 Electron 运行时（修复 dist bundle 时踩过一次：
# unzip 命令被终端折行截断，整包解到了这里并被 git add -A 收走）。
/Electron.app/
/LICENSES.chromium.html
/version

# Per-machine tool permissions. Plans under .claude/plans/ are shared
# deliberately; this file is local state and would churn per developer.
/.claude/settings.local.json

# Generated at release time by scripts/pin-scanner-integrity.mjs. Describes the
# scanner tree it sits beside, so it is not source and must not be committed —
# a stale pin would report a clean tree as tampered.
/resources/guardrail/skill-sentry.INTEGRITY

# Written by scripts/strip-closed-source-scanner.mjs when building an
# open-source distribution. Not source: its presence in a normal checkout would
# tell the app the bundled scanner is intentionally absent.
/resources/guardrail/SCANNER_ABSENT
# Hermes desktop attachments (PRD/转写等敏感文件，勿入库)
/.hermes/
