{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-product/gate-decision.schema.json",
  "title": "AI Product Gate Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "gate_type", "status", "evidence_refs", "claims_allowed", "claims_prohibited"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "gate-decision"},
    "id": {"type": "string", "pattern": "^GATE-[A-Z0-9-]+$"},
    "gate_type": {"enum": ["frame", "evidence", "ai-fit-authority", "discovery", "experiment-contract", "release-readiness", "learning-evolution"]},
    "status": {"enum": ["proposed", "approved", "returned", "blocked", "rejected"]},
    "owner": {"type": ["string", "null"]},
    "reviewer": {"type": ["string", "null"]},
    "decided_at": {"type": ["string", "null"], "format": "date-time"},
    "reason": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^EV-"}},
    "claims_allowed": {"type": "array", "items": {"type": "string"}},
    "claims_prohibited": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["approved", "returned", "rejected"]}}},
      "then": {
        "required": ["owner", "decided_at", "reason"],
        "properties": {
          "owner": {"type": "string", "minLength": 1},
          "decided_at": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"minItems": 1}
        }
      }
    }
  ]
}
