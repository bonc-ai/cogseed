{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-product/spec-handoff.schema.json",
  "title": "AI Product Spec Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "product_version", "frozen_problem", "user_goal", "primary_journey", "object_refs", "state_refs", "authority_ref", "evidence_refs", "discovery_gate_ref", "discovery_gate_status", "open_assumptions", "ready_for_speckit", "next_command"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "spec-handoff"},
    "id": {"type": "string", "pattern": "^HANDOFF-[A-Z0-9-]+$"},
    "product_version": {"type": "string", "minLength": 1},
    "frozen_problem": {"type": "string", "minLength": 1},
    "user_goal": {"type": "string", "minLength": 1},
    "primary_journey": {"type": "string", "minLength": 1},
    "object_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "state_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authority_ref": {"type": "string", "pattern": "^AUTH-"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EV-"}},
    "discovery_gate_ref": {"type": "string", "pattern": "^GATE-"},
    "discovery_gate_status": {"enum": ["proposed", "approved", "returned", "blocked", "rejected"]},
    "open_assumptions": {"type": "array", "items": {"type": "string"}},
    "blocking_gaps": {"type": "array", "items": {"type": "string"}},
    "ready_for_speckit": {"type": "boolean"},
    "next_command": {"const": "speckit.specify"}
  },
  "allOf": [
    {
      "if": {"properties": {"ready_for_speckit": {"const": true}}},
      "then": {"properties": {"discovery_gate_status": {"const": "approved"}}}
    }
  ]
}
